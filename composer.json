{
    "name": "hapipay/php-client",
    "description": "Client PHP de l'API HapiPay : paiements mobile money, carte et PayPal, transferts vers les comptes particuliers, webhooks signés.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/HapiPay/hapipay-php-client",
    "keywords": ["hapipay", "mobile money", "paiement", "airtel money", "mvola", "orange money", "webhook", "laravel"],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "suggest": {
        "illuminate/support": "Intégration Laravel : configuration, injection du client, vérification des webhooks."
    },
    "autoload": {
        "psr-4": { "HapiPay\\Client\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "HapiPay\\Client\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["HapiPay\\Client\\Laravel\\HapiPayClientServiceProvider"]
        }
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable"
}
